-- TARGET SEARCH ENGINE (Screen Center)
-- ══════════════════════════════════════════════════════
local function FindTarget()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best, bestD = nil, math.huge
    local myPos = Camera.CFrame.Position
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then myPos = myRoot.Position end

    -- Search Players
    for _, plr in ipairs(Players:GetPlayers()) do
        if ShouldTarget(plr) then
            local c = plr.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - myPos).Magnitude <= CFG.AimbotMaxDist then
                local bone = GetAimbotPart(c, CFG.AimbotBone)
                if bone then
                    -- Check if ANY visible part of character is inside the FOV circle
                    local inFOV = false
                    local minD = math.huge
                    local checkParts = {bone, root, c:FindFirstChild("Head"), c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso")}
                    for _, p in ipairs(checkParts) do
                        if p and p:IsA("BasePart") then
                            local sp, vis = W2S(p.Position)
                            if vis then
                                local d = (screenCenter - sp).Magnitude
                                if d <= CFG.AimbotFOV and d < minD then
                                    inFOV = true
                                    minD = d
                                end
                            end
                        end
                    end

                    if inFOV and minD < bestD then
                        if not CFG.AimbotWallCheck or CFG.Wallbang or IsVisibleThroughWall(bone) then
                            bestD = minD
                            best = {char = c, bone = bone}
                        end
                    end
                end
            end
        end
    end

    -- Search Bots (BPBot)
    if CFG.AimbotTargetBots and not CFG.AimbotWantedOnly then
        pcall(function()
            for _, char in ipairs(CollectionService:GetTagged("BPBot")) do
                if char:IsA("Model") and char:FindFirstChild("HumanoidRootPart") then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root and (root.Position - myPos).Magnitude <= CFG.AimbotMaxDist then
                            local bone = GetAimbotPart(char, CFG.AimbotBone)
                            if bone then
                                local inFOV = false
                                local minD = math.huge
                                local checkParts = {bone, root, char:FindFirstChild("Head")}
                                for _, p in ipairs(checkParts) do
                                    if p and p:IsA("BasePart") then
                                        local sp, vis = W2S(p.Position)
                                        if vis then
                                            local d = (screenCenter - sp).Magnitude
                                            if d <= CFG.AimbotFOV and d < minD then
                                                inFOV = true
                                                minD = d
                                            end
                                        end
                                    end
                                end
                                if inFOV and minD < bestD then
                                    if not CFG.AimbotWallCheck or CFG.Wallbang or IsVisibleThroughWall(bone) then
                                        bestD = minD
                                        best = {char = char, bone = bone}
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    return best
end

