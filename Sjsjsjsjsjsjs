-- SILENT AIM & BUTTER-SMOOTH CAMERA LOCK TICK
-- ══════════════════════════════════════════════════════
local function AimbotTick()
    if not CFG.AimbotEnabled or not introComplete then
        lockedTarget = nil
        currentSilentTarget = nil
        return
    end

    -- Determine trigger state
    local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    local isAiming   = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    local active = false
    if CFG.AimbotTrigger == "Shoot Only" then
        active = isShooting
    elseif CFG.AimbotTrigger == "Aim Only" then
        active = isAiming
    elseif CFG.AimbotTrigger == "Always Active" then
        active = true
    else
        active = isShooting or isAiming
    end

    if not active then
        lockedTarget = nil
        currentSilentTarget = nil
        return
    end

    -- Auto-Switch: check if current target died or left range
    if lockedTarget then
        local hum = lockedTarget:FindFirstChildOfClass("Humanoid")
        local root = lockedTarget:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not root or not lockedTarget.Parent then
            lockedTarget = nil
            currentSilentTarget = nil
        else
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and (root.Position - myRoot.Position).Magnitude > CFG.AimbotMaxDist then
                lockedTarget = nil
                currentSilentTarget = nil
            end
        end
    end

    local tgt = nil
    if CFG.AimbotStickyLock and lockedTarget then
        local bone = GetAimbotPart(lockedTarget, CFG.AimbotBone)
        if bone and (not CFG.AimbotWallCheck or CFG.Wallbang or IsVisibleThroughWall(bone)) then
            tgt = {char = lockedTarget, bone = bone}
        else
            lockedTarget = nil
        end
    end

    if not tgt then
        tgt = FindTarget()
        if tgt and CFG.AimbotStickyLock then
            lockedTarget = tgt.char
        end
    end

    if not tgt or not tgt.bone then
        currentSilentTarget = nil
        return
    end

    currentSilentTarget = tgt

    local aimPoint, aimBone = GetAimPosition(tgt)
    if not aimPoint or not aimBone then return end



    -- 1. Clean, Rock-Solid Camera Lock & Weapon Steady Alignment
    if CFG.AimbotMode == "Camera Lock" or CFG.AimbotMode == "Silent + Camera" then
        local cf = Camera.CFrame
        local dir = (aimPoint - cf.Position).Unit
        local goal = CFrame.lookAt(cf.Position, cf.Position + dir)
        local s = math.clamp(CFG.AimbotSmooth or 6, 1, 30)
        local isSnap = (CFG.SnapOnShoot and isShooting) or s <= 1

        if isSnap then
            Camera.CFrame = goal
        else
            local factor = math.clamp(1 / (s * 0.35), 0.08, 0.90)
            Camera.CFrame = cf:Lerp(goal, factor)
        end

        -- Kill CameraRecoil permanently if re-bound
        pcall(function()
            RunService:UnbindFromRenderStep("CameraRecoil")
        end)

        -- Align ViewModel gun model directly with Camera & Target (Zero Upward Kick, Zero Sway, 100% Steady)
        pcall(function()
            local vm = Camera:FindFirstChild("ViewModel")
            if vm then
                vm:PivotTo(Camera.CFrame * CFrame.new(0.9, -0.8, -0.75))
            end
        end)
    end

    -- 2. Silent Bullet Redirect (MouseController + Direct Bullet Hit Vector)
    if MouseController then
        pcall(function()
            MouseController.Target = aimBone
            MouseController.TargetHitPosition = aimPoint
            MouseController.Hit = CFrame.new(aimPoint)
        end)
    end
end

-- ══════════════════════════════════════════════════════
-- TRIGGERBOT (Auto-Fire on Crosshair Intersection)
-- ══════════════════════════════════════════════════════
local lastTriggerShot = 0
local function TriggerbotTick()
    if not CFG.Triggerbot or not introComplete then return end
    local now = tick()
    if now - lastTriggerShot < (CFG.TriggerbotDelay / 1000) then return end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local shouldFire = false

    if currentSilentTarget and currentSilentTarget.char then
        local p, bone = GetAimPosition(currentSilentTarget)
        if p and bone then
            local sp, vis = W2S(p)
            if vis and (screenCenter - sp).Magnitude <= 32 then
                shouldFire = true
            end
        end
    end

    if not shouldFire and MouseController and MouseController.Target then
        local hitChar = MouseController.Target:FindFirstAncestorOfClass("Model")
        local plr = hitChar and Players:GetPlayerFromCharacter(hitChar)
        if plr and ShouldTarget(plr) then
            shouldFire = true
        end
    end

    if shouldFire then
        lastTriggerShot = now
        pcall(function()
            if mouse1click then
                mouse1click()
            elseif mouse1press and mouse1release then
                mouse1press()
                task.wait(0.02)
                mouse1release()
            end
        end)
    end
end

