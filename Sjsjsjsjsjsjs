local function GetAimbotPart(char, preferred)
    if not char then return nil end
    preferred = preferred or CFG.AimbotBone or "Head"

    if preferred == "Head" or preferred == "الرأس" or preferred == "الراس" then
        return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    elseif preferred == "Upper Body" or preferred == "UpperTorso" or preferred == "Torso" or preferred == "الصدر" or preferred == "الابر بدي" or preferred == "الأبر بدي" or preferred == "الجسم العلوي" then
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Head")
    elseif preferred == "HumanoidRootPart" or preferred == "Pelvis" or preferred == "Root" or preferred == "الوسط" or preferred == "الجذع" then
        return char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("LowerTorso")
            or char:FindFirstChild("Torso")
    elseif preferred == "Arms" or preferred == "الأذرع" or preferred == "الأيدي" or preferred == "الذراع" or preferred == "اليدين" then
        return char:FindFirstChild("RightUpperArm")
            or char:FindFirstChild("LeftUpperArm")
            or char:FindFirstChild("Right Arm")
            or char:FindFirstChild("Left Arm")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Head")
    elseif preferred == "Legs" or preferred == "الأرجل" or preferred == "القدمين" or preferred == "الرجل" then
        return char:FindFirstChild("RightUpperLeg")
            or char:FindFirstChild("LeftUpperLeg")
            or char:FindFirstChild("Right Leg")
            or char:FindFirstChild("Left Leg")
            or char:FindFirstChild("HumanoidRootPart")
    elseif preferred == "Random" or preferred == "عشوائي" then
        local parts = {}
        for _, n in ipairs({"Head", "UpperTorso", "Torso", "RightUpperArm", "LeftUpperArm", "HumanoidRootPart"}) do
            local p = char:FindFirstChild(n)
            if p and p:IsA("BasePart") then table.insert(parts, p) end
        end
        if #parts > 0 then return parts[math.random(1, #parts)] end
    else
        -- Case-insensitive / substring fallback
        local pLower = tostring(preferred):lower()
        if pLower:find("arm") or pLower:find("ذراع") or pLower:find("يد") then
            return char:FindFirstChild("RightUpperArm")
                or char:FindFirstChild("LeftUpperArm")
                or char:FindFirstChild("Right Arm")
                or char:FindFirstChild("Left Arm")
                or char:FindFirstChild("UpperTorso")
        elseif pLower:find("leg") or pLower:find("رجل") or pLower:find("قدم") then
            return char:FindFirstChild("RightUpperLeg")
                or char:FindFirstChild("LeftUpperLeg")
                or char:FindFirstChild("Right Leg")
                or char:FindFirstChild("Left Leg")
                or char:FindFirstChild("HumanoidRootPart")
        elseif pLower:find("upper") or pLower:find("torso") or pLower:find("body") or pLower:find("صدر") or pLower:find("بدي") then
            return char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
                or char:FindFirstChild("LowerTorso")
                or char:FindFirstChild("HumanoidRootPart")
        elseif pLower:find("root") or pLower:find("pelvis") or pLower:find("وسط") then
            return char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("LowerTorso")
                or char:FindFirstChild("Torso")
        elseif pLower:find("random") or pLower:find("عشوائي") then
            local parts = {}
            for _, n in ipairs({"Head", "UpperTorso", "Torso", "RightUpperArm", "LeftUpperArm", "HumanoidRootPart"}) do
                local p = char:FindFirstChild(n)
                if p and p:IsA("BasePart") then table.insert(parts, p) end
            end
            if #parts > 0 then return parts[math.random(1, #parts)] end
        end
    end

    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

-- Helper to get exact sub-bone aim coordinate
local function GetAimPosition(tgt)
    if not tgt or not tgt.char then return nil end
    -- Dynamically resolve bone on EVERY call according to current CFG.AimbotBone
    local bone = GetAimbotPart(tgt.char, CFG.AimbotBone) or tgt.bone
    if not bone then return nil end
    tgt.bone = bone -- Keep tgt synchronized with user dropdown choice

    local pos = bone.Position
    if bone.Name == "Head" then
        -- Vertical micro-adjustment ONLY when targeting Head (lowers aimpoint to center of face)
        pos = pos + Vector3.new(0, CFG.AimVerticalOffset or -0.30, 0)
    end

    if CFG.AimbotPrediction and tgt.char then
        local root = tgt.char:FindFirstChild("HumanoidRootPart")
        if root then
            local vel = root.AssemblyLinearVelocity
            pos = pos + Vector3.new(vel.X, 0, vel.Z) * 0.020
        end
    end
    return pos, bone
end

