local function DrawESP(char, e, col, dName, isBot2, stars)
    if not CFG.ESPEnabled or not introComplete then HideESP(e) return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then HideESP(e) return end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then HideESP(e) return end

    local dist = (root.Position - myRoot.Position).Magnitude
    if dist > CFG.ESPMaxDist then HideESP(e) return end

    e.Char = char

    -- Fast, precise Head & Root 3D bounds
    local head = char:FindFirstChild("Head")
    local top3D = head and (head.Position + Vector3.new(0, 0.75, 0)) or (root.Position + Vector3.new(0, 2.7, 0))
    local bot3D = root.Position - Vector3.new(0, 3.1, 0)

    local topSP, topVis, topDepth = W2S(top3D)
    local botSP, botVis, botDepth = W2S(bot3D)
    local rootSP, rootVis, rootDepth = W2S(root.Position)

    if (not topVis and not botVis and not rootVis) or rootDepth < 1 then
        HideESP(e)
        return
    end

    local minY = math.min(topSP.Y, botSP.Y)
    local maxY = math.max(topSP.Y, botSP.Y)
    local height = maxY - minY
    if height < 3 or height > 2200 then HideESP(e) return end

    local width = math.clamp(height * 0.55, 6, 800)
    local cx = rootSP.X
    local x = cx - (width * 0.5)
    local y = minY

    -- 2D Box
    if CFG.BoxESP and e.Box and e.BoxOutline then
        e.BoxOutline.Position = Vector2.new(x, y)
        e.BoxOutline.Size = Vector2.new(width, height)
        e.BoxOutline.Visible = true

        e.Box.Position = Vector2.new(x, y)
        e.Box.Size = Vector2.new(width, height)
        e.Box.Color = col
        e.Box.Visible = true
    else
        if e.Box then e.Box.Visible = false end
        if e.BoxOutline then e.BoxOutline.Visible = false end
    end

    -- Horizontal Top Health Bar (Like in screenshot)
    local hp, mhp = GetHP(char)
    local frac = math.clamp(hp / mhp, 0, 1)

    if CFG.HealthBarESP and e.HP and e.HPBG then
        local barW = math.clamp(width * 0.75, 36, 65)
        local barX = cx - (barW * 0.5)
        local barY = y - 22

        e.HPBG.From = Vector2.new(barX, barY)
        e.HPBG.To = Vector2.new(barX + barW, barY)
        e.HPBG.Thickness = 3
        e.HPBG.Color = Color3.fromRGB(30, 33, 42)
        e.HPBG.Visible = true

        e.HP.From = Vector2.new(barX, barY)
        e.HP.To = Vector2.new(barX + (barW * frac), barY)
        e.HP.Thickness = 3
        e.HP.Color = Color3.fromRGB(46, 204, 113)
        e.HP.Visible = true
    else
        if e.HP then e.HP.Visible = false end
        if e.HPBG then e.HPBG.Visible = false end
    end

    -- Name & Stars
    if CFG.NamesESP and e.Name then
        local lbl = ""
        if isBot2 then
            lbl = "[BOT] " .. (dName or "Bot")
        elseif stars and stars > 0 then
            local starStr = string.rep("★", stars)
            lbl = "[" .. starStr .. "] " .. (dName or "Suspect")
        else
            lbl = dName or "?"
        end

        e.Name.Text = lbl
        e.Name.Position = Vector2.new(cx, y - 16)
        e.Name.Color = (stars and stars > 0) and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(255, 255, 255)
        e.Name.Visible = true
    else
        if e.Name then e.Name.Visible = false end
    end

    -- HP Label (HP: 100)
    if e.HPText then
        if CFG.HealthBarESP then
            e.HPText.Text = string.format("HP: %d", math.floor(hp))
            e.HPText.Position = Vector2.new(cx, y - 2)
            e.HPText.Color = Color3.fromRGB(61, 250, 126)
            e.HPText.Visible = true
        else
            e.HPText.Visible = false
        end
    end

    -- Distance (Dist: 956)
    if CFG.DistanceESP and e.Dist then
        e.Dist.Text = string.format("Dist: %d", math.floor(dist))
        e.Dist.Position = Vector2.new(cx, y + 12)
        e.Dist.Color = Color3.fromRGB(220, 220, 220)
        e.Dist.Visible = true
    else
        if e.Dist then e.Dist.Visible = false end
    end

    -- Tracer
    if CFG.TracersESP and e.Tracer then
        local vp = Camera.ViewportSize
        e.Tracer.From = Vector2.new(vp.X / 2, vp.Y)
        e.Tracer.To = Vector2.new(cx, y + height)
        e.Tracer.Color = col
        e.Tracer.Visible = true
    else
        if e.Tracer then e.Tracer.Visible = false end
    end

    -- Skeleton (Optimized: Only rendered for targets within 200m)
    if CFG.SkeletonESP and e.Skel and dist <= 200 and height >= 16 then
        local sk = char:FindFirstChild("UpperTorso") and SKEL_R15 or SKEL_R6
        for i, cn in ipairs(sk) do
            local ln = e.Skel[i]
            if ln then
                local pA = char:FindFirstChild(cn[1])
                local pB = char:FindFirstChild(cn[2])
                if pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
                    local sA, vA = W2S(pA.Position)
                    local sB, vB = W2S(pB.Position)
                    if vA and vB then
                        ln.From = sA; ln.To = sB; ln.Color = col; ln.Visible = true
                    else
                        ln.Visible = false
                    end
                else
                    ln.Visible = false
                end
            end
        end
    else
        if e.Skel then
            for _, ln in ipairs(e.Skel) do ln.Visible = false end
        end
    end

    -- Chams (Always On Top)
    if CFG.ChamsESP then
        UpdateHighlight(char, col, true)
    else
        UpdateHighlight(char, nil, false)
    end
end

-- ══════════════════════════════════════════════════════
-- ESP MAIN LOOP
-- ══════════════════════════════════════════════════════
local function ESPLoop()
    if not CFG.ESPEnabled or not introComplete then
        for _, e in pairs(espCache) do HideESP(e) end
        return
    end

    local currentPlayers = {}

    -- Render Players
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            currentPlayers[plr] = true
            if not espCache[plr] then
                espCache[plr] = CreateDrawing()
            end
            local e = espCache[plr]
            if ShouldShowESP(plr) then
                local r = GetRole(plr)
                local col = CFG.EnemyColor
                if r == "Authority" then
                    col = CFG.PoliceColor
                elseif r == "Civilian" then
                    col = CFG.FriendlyColor
                end
                local stars = GetPlayerWantedStars(plr)
                DrawESP(plr.Character, e, col, plr.DisplayName or plr.Name, false, stars)
            else
                HideESP(e)
            end
        end
    end

    -- Render Bots (BPBot)
    if CFG.ESPEnabled and CFG.ESPTargetBots and not CFG.ESPWantedOnly then
        pcall(function()
            for _, char in ipairs(CollectionService:GetTagged("BPBot")) do
                if char:IsA("Model") and char:FindFirstChild("HumanoidRootPart") then
                    currentPlayers[char] = true
                    if not espCache[char] then
                        espCache[char] = CreateDrawing()
                    end
                    local e = espCache[char]
                    DrawESP(char, e, CFG.BotColor, char.Name, true, 0)
                end
            end
        end)
    end

    -- Cleanup Disconnected Entities
    for obj, e in pairs(espCache) do
        if not currentPlayers[obj] then
            RemoveESP(e)
            espCache[obj] = nil
        end
    end
end

-- Clean removal on player leave
Players.PlayerRemoving:Connect(function(plr)
    if espCache[plr] then
        RemoveESP(espCache[plr])
        espCache[plr] = nil
    end
end)

