local function IsAlive(player)
    local c = player and player.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") ~= nil
end

local function GetRole(player)
    local c = player and player.Character
    if not c then return "Civilian" end
    if CollectionService:HasTag(c, "Authority") then return "Authority" end
    if CollectionService:HasTag(c, "Criminal") then return "Criminal" end
    local t = player.Team
    if t then
        local n = t.Name:lower()
        if n:find("police") or n:find("cop") or n:find("sheriff") or n:find("swat") or n:find("authority") then
            return "Authority"
        end
        if n:find("criminal") or n:find("prisoner") then return "Criminal" end
    end
    return "Civilian"
end

local function GetPlayerWantedStars(plr)
    if not plr then return 0, 0 end
    local val = plr:GetAttribute("WantedLevel")
    if typeof(val) ~= "number" or val <= 0 then
        if plr.Character then
            val = plr.Character:GetAttribute("WantedLevel")
        end
    end
    if typeof(val) == "number" and val > 0 then
        local stars = math.clamp(math.ceil(val / 200), 1, 5)
        return stars, val
    end
    if plr.Character and CollectionService:HasTag(plr.Character, "WantedStars") then
        return 1, 100
    end
    return 0, 0
end

local function ShouldTarget(player)
    if player == LocalPlayer or not IsAlive(player) then return false end
    local r = GetRole(player)
    if CFG.AimbotTeamCheck then
        if LocalPlayer.Team and player.Team and player.Team == LocalPlayer.Team then
            return false -- Protect fellow teammates in the same team
        end
    end
    return true
end

local function ShouldShowESP(player)
    if player == LocalPlayer or not IsAlive(player) then return false end
    local r = GetRole(player)
    if CFG.ESPTeamCheck then
        if LocalPlayer.Team and player.Team and player.Team == LocalPlayer.Team then
            return false -- Hide teammates in the same team
        end
    end
    return true
end

local function W2S(pos)
    local v, vis = Camera:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), vis, v.Z
end

local function GetHP(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health or 100, h and h.MaxHealth or 100
end

-- Smart Line-of-Sight Check (Wall Check)
local function IsVisibleThroughWall(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local list = {}
    if LocalPlayer.Character then table.insert(list, LocalPlayer.Character) end
    if part.Parent then table.insert(list, part.Parent) end
    params.FilterDescendantsInstances = list
    return Workspace:Raycast(origin, dir, params) == nil
end

