-- TOGGLE GUI (Silky Quart Pop-In Animation)
-- ══════════════════════════════════════════════════════
local function ToggleGUI()
    guiOpen = not guiOpen
    if not MainFrame or not uiScale then return end

    if guiOpen then
        MainFrame.Visible = true
        MainFrame.BackgroundTransparency = 0.5
        uiScale.Scale = 0.90

        TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1.0}):Play()
        TweenService:Create(MainFrame, TweenInfo.new(0.20, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
    else
        TweenService:Create(uiScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.90}):Play()
        TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        task.delay(0.20, function()
            if not guiOpen then
                MainFrame.Visible = false
            end
        end)
    end
end

