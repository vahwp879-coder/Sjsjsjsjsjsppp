    trigger.Text = ""
    trigger.Parent = bg

    local sliding = false
    local function update(input)
        local posX = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local val = math.floor(minV + (maxV - minV) * posX)
        fill.Size = UDim2.new(posX, 0, 1, 0)
        vl.Text = tostring(val)
        cb(val)
    end

    trigger.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            update(i)
        end
    end)
    trigger.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then update(i) end
    end)
