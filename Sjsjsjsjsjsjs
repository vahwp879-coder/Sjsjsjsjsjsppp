RunService.Heartbeat:Connect(function()
    pcall(function()
        if introComplete then
            ESPLoop()
            if CFG.SpinBot and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local root = LocalPlayer.Character.HumanoidRootPart
                root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(CFG.SpinSpeed or 35), 0)
            end
            hookTicker = (hookTicker or 0) + 1
            if hookTicker % 90 == 0 then
                HookGuns()
                ApplyNoRecoil(CFG.NoRecoil or CFG.ZeroSpread)
            end
            reloadTicker = (reloadTicker or 0) + 1
            if reloadTicker % 30 == 0 then
                ScanAndHookAnimators()
            end
            CrimFeatures()
        end
    end)
end)
