            fovCircle.Radius = CFG.AimbotFOV
            fovCircle.Color = CFG.FOVCircleColor
            fovCircle.Visible = CFG.AimbotEnabled and CFG.ShowFOVCircle and introComplete
        end

        local showCH = CFG.CustomCrosshair and introComplete
        if chVOut and chHOut and chVCore and chHCore then
            chVOut.Visible = showCH
            chHOut.Visible = showCH
            chVCore.Visible = showCH
            chHCore.Visible = showCH

            if showCH then
                local cx = math.floor(center.X)
                local cy = math.floor(center.Y)
                local S = math.floor(CFG.CrosshairSize or 14)
                if S % 2 ~= 0 then S = S + 1 end
                local half = math.floor(S / 2)

                chVOut.Position = Vector2.new(cx - 2, cy - half)
                chVOut.Size = Vector2.new(4, S)

                chHOut.Position = Vector2.new(cx - half, cy - 2)
                chHOut.Size = Vector2.new(S, 4)

                chVCore.Position = Vector2.new(cx - 1, cy - half + 1)
                chVCore.Size = Vector2.new(2, S - 2)

                chHCore.Position = Vector2.new(cx - half + 1, cy - 1)
                chHCore.Size = Vector2.new(S - 2, 2)
            end
        end

        if crosshairFrame then
            crosshairFrame.Visible = showCH
        end

        pcall(function()
            for anim, _ in pairs(hookedAnimators) do
                if anim and anim.Parent then
                    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                        if CFG.FastReload and IsReloadTrack(track) then
                            local speed = math.clamp(CFG.ReloadSpeed or 1.35, 1, 5)
                            if track.Speed ~= speed then
                                track:AdjustSpeed(speed)
                            end
                        end
                        if CFG.NoRecoil and IsFireTrack(track) then
                            track:AdjustWeight(0.001)
                        end
                    end
                else
                    hookedAnimators[anim] = nil
                end
            end
        end)
    end)
end)

