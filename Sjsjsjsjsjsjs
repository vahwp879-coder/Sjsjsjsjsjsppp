local function ApplyNoRecoil(enabled)
    pcall(function()
        local GunConfig = require(ReplicatedStorage.SharedModules.Configs.GunConfig)
        for name, data in pairs(GunConfig) do
            if data and data.Stats then
                if not originalGunStats[name] then
                    originalGunStats[name] = {
                        TPRecoil = data.Stats.ThirdPersonCameraRecoilFactor or 0,
                        FPRecoil = data.Stats.FirstPersonCameraRecoilFactor or 0,
                        Spread = data.Stats.BulletSpreadDegrees or 0,
                        ShotgunSpread = data.Stats.ShotgunSpreadDegrees or 0
                    }
                end
                if enabled then
                    data.Stats.ThirdPersonCameraRecoilFactor = 0
                    data.Stats.FirstPersonCameraRecoilFactor = 0
                    data.Stats.BulletSpreadDegrees = 0
                    data.Stats.ShotgunSpreadDegrees = 0
                else
                    local orig = originalGunStats[name]
                    data.Stats.ThirdPersonCameraRecoilFactor = orig.TPRecoil
                    data.Stats.FirstPersonCameraRecoilFactor = orig.FPRecoil
                    data.Stats.BulletSpreadDegrees = orig.Spread
                    data.Stats.ShotgunSpreadDegrees = orig.ShotgunSpread
                end
            end
            if CFG.NoCameraBob and data and data.Animations and data.Animations.FirstPerson then
                data.Animations.FirstPerson.RunCameraAnim = nil
            end
        end
    end)

    -- Unbind all recoil, smooth look & exit transitions
    pcall(function() RunService:UnbindFromRenderStep("CameraRecoil") end)
    pcall(function() RunService:UnbindFromRenderStep("CameraSmoothLook") end)
    pcall(function() RunService:UnbindFromRenderStep("FirstPersonCameraExitTransition") end)

    -- Zero Camera Pitch Impulse & Recoil Spring (Zero Camera Shake & Recoil)
    pcall(function()
        local CameraController = require(ReplicatedStorage.ClientModules.CameraController)
        if CameraController then
            CameraController.ImpulsePitch = function(...) end
            local s = CameraController:GetRecoilSpring()
            if s then
                s.Position = 0
                s.Target = 0
                s.Speed = 0
                s.Impulse = function(...) end
            end
            CameraController.GetRecoilSpring = function(...) return dummySpring end
            if CFG.NoCameraBob then
                CameraController.ShakeOnce = function(...) end
            end
        end
    end)
end

-- Hook Aim, Reload, Wallbang & Camera Systems
local function HookGuns()
    -- 1. Aim Module Hook
    pcall(function()
        local Aim = require(ReplicatedStorage.ClientModules.GunController.Aim)
        if Aim and not Aim._SecritHooked then
            Aim._SecritHooked = true

            -- Force hip-fire aim to always converge
            Aim.MIN_AIM_CONVERGE_DISTANCE = -999999

            -- Always reachable so GunController never falls back to camera lookvector
            Aim.IsAimPointReachable = function(self, p9, p10)
                return true
            end

            -- Return exact target aim point
            local oldResolveCameraAimPoint = Aim.ResolveCameraAimPoint
            Aim.ResolveCameraAimPoint = function(self, cam, range, p14, p15)
                if CFG.AimbotEnabled or CFG.Wallbang then
                    local tgt = currentSilentTarget
                    if not (tgt and tgt.char and tgt.char.Parent) then tgt = FindTarget() end
                    if tgt and tgt.char then
                        local p = GetAimPosition(tgt)
                        if p then return p end
                    end
                end
                return oldResolveCameraAimPoint(self, cam, range, p14, p15)
            end

            -- Return exact direction vector directly into target
            local oldResolveConverged = Aim.ResolveConvergedDirection
            Aim.ResolveConvergedDirection = function(self, p5, p6, p7)
                if CFG.AimbotEnabled or CFG.Wallbang then
                    local tgt = currentSilentTarget
                    if not (tgt and tgt.char and tgt.char.Parent) then tgt = FindTarget() end
                    if tgt and tgt.char then
                        local p = GetAimPosition(tgt)
                        if p then
                            return (p - p5).Unit
                        end
                    end
                end
                return oldResolveConverged(self, p5, p6, p7)
            end
        end
    end)

    -- 2. MouseController Hook
    pcall(function()
        if not MouseController then
            pcall(function()
                MouseController = require(ReplicatedStorage.ClientModules.MouseController)
            end)
        end
        if MouseController then
            pcall(function()
                MouseController:EnableTargetRaycast("SecritAimbot")
            end)
            if not MouseController._SecritHooked then
                MouseController._SecritHooked = true
                local oldUpdate = MouseController.Update
                MouseController.Update = function(self)
                    oldUpdate(self)
                    if CFG.AimbotEnabled or CFG.Wallbang then
                        local tgt = currentSilentTarget
                        if not (tgt and tgt.char and tgt.char.Parent) then tgt = FindTarget() end
                        if tgt and tgt.char then
                            local p, bone = GetAimPosition(tgt)
                            if p and bone then
                                self.Target = bone
                                self.TargetHitPosition = p
                                self.Hit = CFrame.new(p)
                            end
                        end
                    end
                end
            end
        end
    end)

    -- 3. Quick Reload Engine (Ensures ammo actually refills and never stays at 0)
    pcall(function()
        local Remotes = require(ReplicatedStorage.SharedModules.Pronghorn.Remotes)
        local gunService = Remotes and Remotes.Client and Remotes.Client.GunService
        if gunService and not gunService._SecritReloadHooked then
            gunService._SecritReloadHooked = true
            local oldReload = gunService.Reload
            gunService.Reload = function(self, ...)
                local ammo, stored = oldReload(self, ...)
                if CFG.FastReload and type(ammo) ~= "number" then
                    -- If server rejected fast reload, retry until accepted
                    local deadline = tick() + 2.5
                    while type(ammo) ~= "number" and tick() < deadline do
                        task.wait(0.08)
                        ammo, stored = oldReload(self, ...)
                    end
                end
                return ammo, stored
            end
        end
    end)

    -- 4. Wallbang Engine (Shoot Through Walls, Doors & Obstacles)
    pcall(function()
        local DynamicCast = require(ReplicatedStorage.SharedModules.QueryUtils.DynamicCast)
        if DynamicCast and not DynamicCast._SecritWallbangHooked then
            DynamicCast._SecritWallbangHooked = true
            local oldRun = DynamicCast.Run
            DynamicCast.Run = function(p5, p6, p7, p8, p9, p10, p11, p12, p13)
                -- 1. Direct Target Hitscan when Aimbot or Wallbang has active target
                if CFG.AimbotEnabled or CFG.Wallbang then
                    local tgt = currentSilentTarget
                    if not (tgt and tgt.char and tgt.char.Parent) then
                        tgt = FindTarget()
                    end
                    if tgt and tgt.char then
                        local p, bone = GetAimPosition(tgt)
                        if p and bone then
                            local fakeHit = {
                                Instance = bone,
                                Position = p,
                                Normal = Vector3.new(0, 1, 0),
                                Material = Enum.Material.Plastic,
                                Distance = (p - p5).Magnitude
                            }
                            return fakeHit, {}
                        end
                    end
                end

                -- 2. Multi-Layer Wallbang Penetration Engine (Pierces any number of walls/doors)
                if CFG.Wallbang then
                    local origin = p5
                    local dir = p6
                    local totalDist = dir.Magnitude
                    if totalDist > 0.001 then
                        local exclude = {}
                        if p7 and p7.ExcludeInstances then
                            for _, inst in ipairs(p7.ExcludeInstances) do table.insert(exclude, inst) end
                        end
                        if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end

                        local filter = RaycastParams.new()
                        filter.FilterType = Enum.RaycastFilterType.Exclude
                        filter.FilterDescendantsInstances = exclude
                        filter.IgnoreWater = true

                        local currentOrigin = origin
                        local unitDir = dir.Unit
                        local finalHit = nil
                        local lastHit = nil

                        for _ = 1, 25 do
                            local traveled = (currentOrigin - origin).Magnitude
                            local remainDist = totalDist - traveled
                            if remainDist <= 0.1 then break end

                            local hit = workspace:Raycast(currentOrigin, unitDir * remainDist, filter)
                            if not hit then break end
                            lastHit = hit

                            local hitPart = hit.Instance
                            local hitChar = nil
                            if hitPart and hitPart.Parent then
                                if hitPart.Parent:FindFirstChildOfClass("Humanoid") or hitPart.Parent:HasTag("Character") or Players:GetPlayerFromCharacter(hitPart.Parent) then
                                    hitChar = hitPart.Parent
                                elseif hitPart.Parent.Parent and (hitPart.Parent.Parent:FindFirstChildOfClass("Humanoid") or hitPart.Parent.Parent:HasTag("Character") or Players:GetPlayerFromCharacter(hitPart.Parent.Parent)) then
                                    hitChar = hitPart.Parent.Parent
                                end
                            end

                            if hitChar and hitChar ~= LocalPlayer.Character then
                                finalHit = hit
                                break
                            end

                            -- Pierce through wall, window, door, or prop
                            table.insert(exclude, hitPart)
                            filter.FilterDescendantsInstances = exclude
                            currentOrigin = hit.Position + unitDir * 0.15
                        end

                        if finalHit then
                            return finalHit, {}
                        elseif lastHit then
                            return lastHit, {}
                        end
                    end
                end

                return oldRun(p5, p6, p7, p8, p9, p10, p11, p12, p13)
            end
        end

        -- Direct Remote Event TryShoot Hook: 100% Server Hit Registration with Wall Bypass
        local Remotes = require(ReplicatedStorage.SharedModules.Pronghorn.Remotes)
        local gunService = Remotes and Remotes.Client and Remotes.Client.GunService
        if gunService and not gunService._SecritShootHooked then
            gunService._SecritShootHooked = true
            local oldTryShoot = gunService.TryShoot
            gunService.TryShoot = function(self, shots, ...)
                if (CFG.AimbotEnabled or CFG.Wallbang) and type(shots) == "table" then
                    local tgt = currentSilentTarget
                    if not (tgt and tgt.char and tgt.char.Parent) then
                        tgt = FindTarget()
                    end
                    if tgt and tgt.char then
                        local hitPos, bone = GetAimPosition(tgt)
                        if hitPos and bone then
                            for i = 1, #shots do
                                local s = shots[i]
                                if type(s) == "table" then
                                    s.TargetCharacter = tgt.char
                                    s.TargetInstance = bone
                                    s.BulletImpactPosition = hitPos
                                    s.TargetSize = bone.Size
                                    s.TargetCFrame = bone.CFrame
                                    s.Normal = Vector3.new(0, 1, 0)
                                    s.Material = Enum.Material.Plastic

                                    if s.MuzzlePosition then
                                        local dir = (hitPos - s.MuzzlePosition).Unit
                                        s.MuzzleDirectionUnit = dir

                                        -- Wallbang Server Obstruction Bypass:
                                        if CFG.Wallbang then
                                            local checkParams = RaycastParams.new()
                                            checkParams.FilterType = Enum.RaycastFilterType.Exclude
                                            local ex = {bone, tgt.char}
                                            if LocalPlayer.Character then table.insert(ex, LocalPlayer.Character) end
                                            checkParams.FilterDescendantsInstances = ex
                                            checkParams.IgnoreWater = true

                                            local obs = workspace:Raycast(s.MuzzlePosition, hitPos - s.MuzzlePosition, checkParams)
                                            if obs and obs.Instance and not obs.Instance:IsDescendantOf(tgt.char) then
                                                -- Wall detected between shooter and target:
                                                -- Move origin to 1.5 studs in front of target so server raycast has 100% unobstructed line of sight
                                                s.MuzzlePosition = hitPos - dir * 1.5
                                                s.MuzzleDirectionUnit = dir
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    elseif CFG.Wallbang then
                        -- Manual shots with Wallbang: check if bullet passed through an obstruction
                        for i = 1, #shots do
                            local s = shots[i]
                            if type(s) == "table" and s.MuzzlePosition and s.BulletImpactPosition and s.TargetInstance then
                                local toTarget = s.BulletImpactPosition - s.MuzzlePosition
                                local dir = toTarget.Unit
                                local checkParams = RaycastParams.new()
                                checkParams.FilterType = Enum.RaycastFilterType.Exclude
                                local ex = {s.TargetInstance}
                                if s.TargetCharacter then table.insert(ex, s.TargetCharacter) end
                                if LocalPlayer.Character then table.insert(ex, LocalPlayer.Character) end
                                checkParams.FilterDescendantsInstances = ex
                                checkParams.IgnoreWater = true

                                local obs = workspace:Raycast(s.MuzzlePosition, toTarget, checkParams)
                                if obs and obs.Instance then
                                    s.MuzzlePosition = s.BulletImpactPosition - dir * 1.5
                                    s.MuzzleDirectionUnit = dir
                                end
                            end
                        end
                    end
                end
                return oldTryShoot(self, shots, ...)
            end
        end
    end)

    pcall(function()
        local CanPierceMod = require(ReplicatedStorage.SharedModules.QueryUtils.CanPierce)
        local hf = hookfunction or replaceclosure
        if hf and type(CanPierceMod) == "function" and not _G._SecritCanPierceHooked then
            _G._SecritCanPierceHooked = true
            local origCanPierce
            origCanPierce = hf(CanPierceMod, function(p8, p9, p10)
                if CFG.Wallbang then
                    if p8 and p8.Parent then
                        local model = p8:FindFirstAncestorOfClass("Model")
                        if model then
                            if model:FindFirstChildOfClass("Humanoid") or model:HasTag("Character") or Players:GetPlayerFromCharacter(model) then
                                return false
                            end
                        end
                    end
                    return true
                end
                return origCanPierce(p8, p9, p10)
            end)
        end
    end)

    -- 5. Camera Shake & Recoil Removal (Zero camera shake/bob when sprinting)
    pcall(function()
        local CameraController = require(ReplicatedStorage.ClientModules.CameraController)
        if CameraController and not CameraController._SecritCameraHooked then
            CameraController._SecritCameraHooked = true
            local oldShake = CameraController.ShakeOnce
            CameraController.ShakeOnce = function(...)
                if CFG.NoCameraBob then return end
                if oldShake then return oldShake(...) end
            end
        end
    end)
end
