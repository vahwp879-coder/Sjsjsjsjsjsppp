-- ══════════════════════════════════════════════════════
local crimTick = 0
local function CrimFeatures()
    crimTick = crimTick + 1
    if crimTick % 20 ~= 0 then return end -- Every ~0.33s

    pcall(function()
        local c = LocalPlayer.Character
        if not c then return end
        if CFG.AntiHandcuffs then
            c:SetAttribute("IsDetained", nil)
            c:SetAttribute("DetainedByUserId", nil)
            c:SetAttribute("Handcuffed", nil)
            c:SetAttribute("Restrained", nil)
        end
        if CFG.AntiTase then
            c:SetAttribute("Tased", nil)
            c:SetAttribute("Stunned", nil)
        end
        if CFG.SpeedBoost then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = CFG.SpeedValue end
        end
    end)
end

