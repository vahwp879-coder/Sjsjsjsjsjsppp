local hookedAnimators = {}

local function IsReloadTrack(track)
    if not track then return false end
    local tname = string.lower(track.Name or "")
    if string.find(tname, "ads") or string.find(tname, "fire") or string.find(tname, "idle") or string.find(tname, "camera") or string.find(tname, "sprint") or string.find(tname, "walk") then
        return false
    end
    if track.Animation then
        local aname = string.lower(track.Animation.Name or "")
        if string.find(aname, "ads") or string.find(aname, "fire") or string.find(aname, "idle") or string.find(aname, "camera") or string.find(aname, "sprint") or string.find(aname, "walk") then
            return false
        end
        if string.find(aname, "reload") then return true end
    end
    if string.find(tname, "reload") or string.find(tname, "mag") then
        return true
    end
    return false
end

local function IsFireTrack(track)
    if not track then return false end
    local anim = track.Animation
    if anim and anim.AnimationId then
        local id = string.match(anim.AnimationId, "%d+")
        if id and fireAnimIds[id] then return true end
    end
    local tname = string.lower(track.Name or "")
    if string.find(tname, "fire") then return true end
    return false
end

local function HandleTrack(track)
    if CFG.FastReload and IsReloadTrack(track) then
        local speed = math.clamp(CFG.ReloadSpeed or 1.35, 1, 5)
        pcall(function()
            track:AdjustSpeed(speed)
        end)
    end
    if CFG.NoRecoil and IsFireTrack(track) then
        pcall(function()
            track:AdjustWeight(0.001)
        end)
    end
end

local function HookAnimator(animator)
    if not animator or hookedAnimators[animator] then return end
    hookedAnimators[animator] = true

    pcall(function()
        animator.AnimationPlayed:Connect(function(track)
            HandleTrack(track)
        end)
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            HandleTrack(track)
        end
    end)
end

local function ScanAndHookAnimators()
    pcall(function()
        if LocalPlayer.Character then
            for _, d in ipairs(LocalPlayer.Character:GetDescendants()) do
                if d:IsA("Animator") then HookAnimator(d) end
            end
        end
    end)
    pcall(function()
        for _, d in ipairs(Camera:GetDescendants()) do
            if d:IsA("Animator") then HookAnimator(d) end
        end
    end)
end
